{
  "name": "liquity-agent-kit",
  "version": "0.3.5",
  "private": true,
  "description": "Read-only TypeScript integration toolkit for Liquity V2 agents",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "catalog": "tsx scripts/generate-catalog.ts",
    "smoke": "tsx scripts/smoke.ts",
    "check": "npm run typecheck && vitest run",
    "abi:extract": "tsx scripts/extract-upstream-signatures.ts",
    "live:redemption": "tsx scripts/live-redemption.ts",
    "mcp": "tsx src/mcp/stdio.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "viem": "^2.38.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
